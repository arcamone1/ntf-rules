alert http $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS (msg:"URLhaus C2 Infrastructure T1071.001"; flow:to_server,established; http.uri; content:"/installer.exe"; nocase; fast_pattern; pcre:"/.*\/installer\.exe$/"; threshold:type threshold,track by_src,count 5,seconds 60; classtype:trojan-activity; metadata:created_at 2026-07-21, signature_severity high, affected_product URLhaus_C2_Infrastructure, attack_target Command_And_Control, deployment perimeter, mitre_technique T1071.001, mitre_tactic command-and-control, author OPSWAT_Nexus_Forge, category c2, confidence high; sid:9188309; rev:1;)
