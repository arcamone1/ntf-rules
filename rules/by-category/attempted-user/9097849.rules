alert smb $HOME_NET any -> $HOME_NET 445 (msg:"OPSWAT Nexus Forge - Block NTLM connections on SMB in Windows Server 2025 T1021.002"; flow:to_server,established; smb.named_pipe; content:"\\ADMIN$"; nocase; fast_pattern; threshold:type limit,track by_src,count 5,seconds 60; classtype:attempted-user; metadata:created_at 2026-05-18, signature_severity high, affected_product Block_NTLM_connections_on_SMB_in_Windows_Server_2025, attack_target Lateral_Movement, deployment perimeter, mitre_technique T1021.002, mitre_tactic lateral-movement, author OPSWAT_Nexus_Forge, category lateral-movement, confidence high; sid:9097849; rev:1;)
